APP_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgresql://restaurant_os:local-development-only@localhost:5432/restaurant_os
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-an-independent-32-character-secret
IDENTITY_TOKEN_PEPPER=replace-with-another-independent-32-character-secret
DEVICE_CREDENTIAL_PEPPER=replace-with-an-independent-device-credential-secret
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Required in production. Fixed server-side URL; never accepted from clients.
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_SECRET=
INVITATION_DELIVERY_WEBHOOK_URL=
INVITATION_DELIVERY_WEBHOOK_SECRET=
DEFAULT_PHONE_COUNTRY=NG
SESSION_TTL_SECONDS=604800
PRIVILEGED_SESSION_TTL_SECONDS=28800
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
