{
  "name": "@restaurant-os/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test",
    "test:security": "vitest run test/security.test.ts test/staff-api.test.ts test/staff-service.test.ts test/menu-api.test.ts test/menu-engine.test.ts test/postgres.integration.test.ts",
    "bootstrap:owner": "tsx src/bootstrap-owner.ts",
    "menu:workbook": "tsx src/menu/workbook-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@restaurant-os/auth": "workspace:*",
    "@restaurant-os/authorization": "workspace:*",
    "@restaurant-os/config": "workspace:*",
    "@restaurant-os/database": "workspace:*",
    "@restaurant-os/logging": "workspace:*",
    "@restaurant-os/security": "workspace:*",
    "@restaurant-os/types": "workspace:*",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "ioredis": "5.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "vitest": "4.1.10"
  }
}
